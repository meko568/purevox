#!/bin/bash
# ============================================================
# purevox - Smart Music Remover (batch capable)
#
# Single file:
#   purevox -i in.mp4 -o out.mp4
#   purevox -i in -o out                  (ext defaults to .mp4)
#
# Multiple files, explicit pairs:
#   purevox -i in1.mp4 in2.mp4 in3.mp4 -o out1.mp4 out2.mp4 out3.mp4
#
# Multiple files, output folder (auto-named same basenames):
#   purevox -i in1.mp4 in2.mp4 -o clean_folder/
#
# Whole folder in, folder out:
#   purevox --dir episodes/ -o clean/
#
# Resume:
#   purevox -r / --resume                 (1 pending job: resume it. several: pick from a checklist)
#   purevox -r 0                          (resume just job id 0 — ids shown by -j/--jobs)
#   purevox -r 0 2 5                      (resume jobs 0, 2 and 5)
#   purevox -r -i in1.mp4 in2.mp4 -o out1.mp4 out2.mp4   (resume by filename instead)
#   purevox -r --dir episodes/ -o clean/  (resume only jobs matching this dir's files)
#
# Every flag has a short and long form:
#   -h/--help  -j/--jobs  -r/--resume  -i/--input  -o/--output
#   -d/--dir  -s/--search  -e/--episodes  -eo/--episodes-out
#   -n/--dry-run  -q/--run-limit  -x/--delete  -c/--chunk
# ============================================================

set -e
shopt -s nullglob

VIDEO_EXTS="mp4 mkv mov avi webm"
AUDIO_EXTS="mp3 wav m4a flac aac ogg wma"

print_help() {
    cat <<'EOF'
purevox — strip background music, keep vocals/dialogue in video files

FLAGS (short / long):
  -h, --help            Show this message.
  -j, --jobs            List every pending/interrupted job.
  -r, --resume          Resume pending/interrupted job(s).
  -i, --input           Input file(s).
  -o, --output          Output file(s) or folder.
  -d, --dir             Whole-folder input mode.
  -s, --search          Search current folder for matching files.
  -e, --episodes        Build INPUT names from prefix + episode numbers.
  -eo, --episodes-out   Build OUTPUT names from prefix + episode numbers.
  -n, --dry-run         Show the plan, touch nothing.
  -q, --run-limit       Register all jobs, only run N of them now.
  -x, --delete          Delete pending job(s).
  -c, --chunk           Force a chunk size (minutes) instead of automatic.

USAGE:
  purevox -i in.mp4 -o out.mp4
      Single file. Extension optional, defaults to .mp4 if omitted.

  purevox -i in1.mp4 in2.mp4 in3.mp4 -o out1.mp4 out2.mp4 out3.mp4
      Multiple files, explicit 1:1 pairing (input count must match output count).

  purevox -i in1.mp4 in2.mp4 -o clean_folder/
      Multiple files, single output FOLDER (no extension on -o/--output value).
      Outputs auto-named after each input's basename + .mp4, saved inside folder.

  purevox --dir episodes/ -o clean/
      Whole folder in, whole folder out (-d/--dir). Every video file
      (mp4/mkv/mov/avi/webm) inside episodes/ gets processed, saved into
      clean/ with matching filename.

  purevox -r
      Resume pending/interrupted job(s) from ~/.purevox/jobs/. If there's
      only one, it just resumes. If there are several, pick from an
      interactive checklist (all selected by default).

  purevox -r 0
      Resume just job id 0 (ids are shown by -j/--jobs), no checklist needed.

  purevox -r 0 2 5
      Resume jobs 0, 2 and 5 by id, skipping the rest.

  purevox -r -i in1.mp4 in2.mp4 -o out1.mp4 out2.mp4
      Resume only these specific file(s) by name instead of by id. Any with
      no matching pending job are skipped with a warning.

  purevox -r --dir episodes/ -o clean/
      Resume only jobs matching files inside this folder.

  purevox --jobs
      List every pending/interrupted job — id, input, output, progress, model.

  purevox --delete
      Pick which pending job(s) to delete from an interactive checklist
      (nothing selected by default — mark what you want gone, then Enter).

  purevox --delete <job_id> [job_id2 ...]
      Delete specific job(s) by id (ids shown by -j/--jobs).

  purevox --delete all
      Delete every pending job.

  purevox --dry-run -i in1.mp4 in2.mp4 -o out1.mp4 out2.mp4
      Show what would happen (pairs, whether an output already exists)
      without touching anything. Works with every mode (-i/-o, -d/--dir,
      -s, -e, -r, ...).

  purevox -q 3 -i in1.mp4 in2.mp4 in3.mp4 in4.mp4 -o clean/
      Register all 4 jobs, but only actually run the first 3 now. The rest
      stay pending — resume them later with 'purevox -r'. If you ask for
      more than exist, it just runs all of them and tells you so.

  Audio files (mp3/wav/m4a/flac/aac/ogg/wma) work as input or output too —
  same as video. If the OUTPUT you give ends in an audio extension (e.g.
  -o clean.mp3), purevox skips the video remux step and saves the isolated
  vocals directly as that audio file — handy even when the INPUT is a video
  and you only want the vocals-only track out of it.

  If an output file already exists, purevox asks before overwriting: a
  single job asks yes/no; a batch with several existing outputs lets you
  overwrite all, skip just the conflicting ones and keep the rest, or
  cancel everything.

  purevox -s attackS1 -o clean/
      Search THIS folder (must be run from inside it) for video files whose
      name contains "attackS1", pick which with an interactive checklist —
      ALL matches are selected by default, Space toggles one off/on,
      Enter processes what's checked, q cancels.

  purevox -e attackS1E 1,2,4 -o clean/
      Build INPUT names from a prefix + episode numbers: attackS1E1,
      attackS1E2, attackS1E4 (any extension in mp4/mkv/mov/avi/webm).
      Ranges work too, e.g. "1-4".

  purevox -e attackS1E 1,2,4 -eo cleanS1E 1,2,4
      -e/--episodes builds INPUT names, -eo/--episodes-out builds OUTPUT
      names — independent flags, use either alone or both together,
      prefix/numbers can differ.

  purevox -c 12 -i in.mp4 -o out.mp4
      Force a 12-minute chunk size instead of the automatic one. Warns and
      asks for y/n confirmation first if 12 min looks unsafe for your RAM/GPU.

  purevox --help
      Show this message.

NOTES:
  - Chunk size and whether to chunk at all are picked automatically from
    detected RAM, GPU VRAM, and each file's duration (heuristic, not an
    exact science — override with -c/--chunk if it's wrong for your machine).
  - Chunked jobs resume per-chunk (only unfinished chunks reprocessed).
  - Job state lives in ~/.purevox/jobs/<hash>/ and is deleted on success.
EOF
}

# ============================================================
# state.json I/O — every read/write goes through python3's json
# module, so paths containing quotes/backslashes/unicode survive
# round-trips exactly (the old heredoc + grep -oP approach broke
# on such characters and on non-GNU systems).
# ============================================================

# write_job_state <state_file> <short_id> <input> <output> <model>
#                 <use_chunks:true|false> <total_chunks>
#                 <chunk_duration> <completed_chunks_csv>
# All values arrive as argv (never interpolated into the JSON text),
# serialised with json.dump, written atomically via .tmp + mv.
write_job_state() {
    local SF="$1" SID="$2" INP="$3" OUTP="$4" MODEL="$5" UC="$6" TC="$7" CD="$8" CC="${9:-}"
    python3 - "$SF" "$SID" "$INP" "$OUTP" "$MODEL" "$UC" "$TC" "$CD" "$CC" >"$SF.tmp" <<'PYEOF'
import json, sys

_, _sf, sid, inp, outp, model, uc, tc, cd, cc = sys.argv[:10]

def as_int(v, default=0):
    try:
        return int(str(v).strip())
    except ValueError:
        return default

completed = []
for tok in cc.split(","):
    tok = tok.strip()
    if tok:
        try:
            completed.append(int(tok))
        except ValueError:
            pass

state = {
    "short_id": as_int(sid),
    "input": inp,
    "output": outp,
    "model": model,
    "use_chunks": uc == "true",
    "total_chunks": as_int(tc),
    "chunk_duration": as_int(cd),
    "completed_chunks": completed,
}
json.dump(state, sys.stdout, indent=2)
sys.stdout.write("\n")
PYEOF
    mv "$SF.tmp" "$SF"
}

# read_state <state_file> — parse state.json safely and print shell-safe
# KEY=value lines (values quoted with shlex.quote), intended for:
#     rs="$(read_state "$sf")" || rs=""
#     if [ -n "$rs" ]; then eval "$rs"; fi
# Sets: SHORT_ID INPUT OUTPUT MODEL USE_CHUNKS TOTAL_CHUNKS
#       CHUNK_DURATION COMPLETED_LIST (comma-separated) COMPLETED_COUNT
# Missing keys come back as ""; returns 1 if the file is missing,
# unparsable, or not a JSON object.
read_state() {
    if [ -z "${1:-}" ] || [ ! -f "$1" ]; then
        return 1
    fi
    python3 - "$1" <<'PYEOF'
import json, shlex, sys

try:
    with open(sys.argv[1], "r", encoding="utf-8", errors="surrogateescape") as f:
        d = json.load(f)
except Exception:
    sys.exit(1)
if not isinstance(d, dict):
    sys.exit(1)

def sval(key):
    v = d.get(key)
    if v is None:
        return ""
    if v is True:
        return "true"
    if v is False:
        return "false"
    return str(v)

w = sys.stdout.buffer
for key in ("short_id", "input", "output", "model",
            "use_chunks", "total_chunks", "chunk_duration"):
    w.write(("%s=%s\n" % (key.upper(), shlex.quote(sval(key)))).encode("utf-8", "surrogateescape"))

cc = d.get("completed_chunks")
items = [str(x) for x in cc] if isinstance(cc, list) else []
w.write(("COMPLETED_LIST=%s\n" % shlex.quote(",".join(items))).encode("utf-8", "surrogateescape"))
w.write(("COMPLETED_COUNT=%d\n" % len(items)).encode("utf-8", "surrogateescape"))
PYEOF
}

# job_hash <absolute_input> — stable job-folder id derived from the
# file's absolute path + byte size (shasum -a 256: available on macOS,
# Linux and WSL alike, unlike GNU md5sum).
job_hash() {
    local sz
    sz="$(wc -c < "$1" | tr -d '[:space:]')"
    printf '%s:%s' "$1" "$sz" | shasum -a 256 | cut -d' ' -f1
}

get_pending_jobs() {
    # fills JOB_SID[] / JOB_HASH[] / JOB_IN[] / JOB_OUT[], sorted by short id
    JOB_SID=(); JOB_HASH=(); JOB_IN=(); JOB_OUT=()
    local JOBS_ROOT="$HOME/.purevox/jobs"
    [ -d "$JOBS_ROOT" ] || return 0
    local jd sf sid hash rs mtime age
    local -a rows=()
    for jd in "$JOBS_ROOT"/*/; do
        sf="${jd}state.json"
        if [ ! -f "$sf" ]; then
            # A folder can legitimately exist without state.json for a
            # moment — register_job() mkdir's the folder, then computes
            # duration/hardware settings, THEN writes state.json. If
            # another purevox process (e.g. the GUI listing jobs) runs
            # during that window, don't treat it as stale — only clean up
            # folders old enough that they're clearly abandoned.
            age=0   # unknown mtime => treat as brand-new, never delete on a guess
            mtime="$(stat -c %Y "$jd" 2>/dev/null)" || mtime="$(stat -f %m "$jd" 2>/dev/null)" || mtime=""
            if [ -n "$mtime" ]; then
                age=$(( $(date +%s) - mtime ))
            fi
            if [ "$age" -lt 60 ]; then
                continue
            fi
            echo "!! Removing stale job folder (no state.json): $(basename "$jd")" >&2
            rm -rf "$jd"
            continue
        fi
        sid=""; SHORT_ID=""; INPUT=""
        rs="$(read_state "$sf")" || rs=""
        if [ -n "$rs" ]; then eval "$rs"; sid="$SHORT_ID"; fi
        if [ -z "$sid" ] || [ -z "$INPUT" ]; then
            # Corrupt/incomplete state: NEVER delete the folder — it may
            # hold hours of cached chunk stems. Warn and skip this job only.
            echo "!! WARNING: unreadable/incomplete state.json, skipping job (folder kept): $(basename "$jd")" >&2
            continue
        fi
        rows+=("$sid|$(basename "$jd")")
    done
    [ ${#rows[@]} -gt 0 ] || return 0
    while IFS='|' read -r sid hash; do
        sf="$JOBS_ROOT/$hash/state.json"
        INPUT=""; OUTPUT=""
        rs="$(read_state "$sf")" || rs=""
        if [ -n "$rs" ]; then eval "$rs"; fi
        JOB_SID+=("$sid")
        JOB_HASH+=("$hash")
        JOB_IN+=("$INPUT")
        JOB_OUT+=("$OUTPUT")
    done < <(printf '%s\n' "${rows[@]}" | sort -t'|' -k1,1n)
    return 0
}

# resolve_job_id <token> — echoes the job's hash dir name given either its
# short numeric id (0,1,2...) or the raw hash itself. Empty if not found.
# Assumes get_pending_jobs already ran.
resolve_job_id() {
    local token="$1"
    local k
    if [[ "$token" =~ ^[0-9]+$ ]]; then
        for k in "${!JOB_SID[@]}"; do
            [ "${JOB_SID[$k]}" == "$token" ] && { echo "${JOB_HASH[$k]}"; return 0; }
        done
    else
        for k in "${!JOB_HASH[@]}"; do
            [ "${JOB_HASH[$k]}" == "$token" ] && { echo "${JOB_HASH[$k]}"; return 0; }
        done
    fi
    return 0
}

# init_next_sid — sets NEXT_SID to one past the highest existing job's id
# (0 if there are no jobs yet). Call once before registering new jobs.
init_next_sid() {
    get_pending_jobs
    local m=-1
    local s
    for s in "${JOB_SID[@]}"; do
        if [[ "$s" =~ ^[0-9]+$ ]] && [ "$s" -gt "$m" ]; then
            m="$s"
        fi
    done
    NEXT_SID=$((m + 1))
    return 0
}

list_jobs() {
    get_pending_jobs
    if [ ${#JOB_HASH[@]} -eq 0 ]; then
        echo "No pending jobs."
        return 0
    fi
    local k jd sf rs
    for k in "${!JOB_HASH[@]}"; do
        jd="$HOME/.purevox/jobs/${JOB_HASH[$k]}"
        sf="$jd/state.json"
        SHORT_ID=""; INPUT=""; OUTPUT=""; MODEL=""; USE_CHUNKS=""
        TOTAL_CHUNKS=""; CHUNK_DURATION=""; COMPLETED_LIST=""; COMPLETED_COUNT=""
        rs="$(read_state "$sf")" || rs=""
        if [ -n "$rs" ]; then eval "$rs"; fi

        echo "[${JOB_SID[$k]}] Job: ${JOB_HASH[$k]}"
        echo "  input:   ${JOB_IN[$k]}"
        echo "  output:  ${JOB_OUT[$k]}"
        echo "  model:   $MODEL"
        if [ "$USE_CHUNKS" == "true" ]; then
            echo "  progress: ${COMPLETED_COUNT:-0} / ${TOTAL_CHUNKS:-0} chunks done"
        else
            [ -f "$jd/stems/vocals.mp3" ] && echo "  progress: vocals separated, pending remux" \
                || echo "  progress: not yet separated"
        fi
        echo ""
    done
    return 0
}

delete_jobs() {
    get_pending_jobs
    if [ ${#JOB_HASH[@]} -eq 0 ]; then
        echo "No pending jobs."
        return 0
    fi
    local JOBS_ROOT="$HOME/.purevox/jobs"

    local -a TO_DELETE=()
    if [ "$1" == "all" ]; then
        TO_DELETE=("${JOB_HASH[@]}")
    elif [ $# -gt 0 ]; then
        local tok resolved
        for tok in "$@"; do
            resolved="$(resolve_job_id "$tok")"
            if [ -n "$resolved" ]; then
                TO_DELETE+=("$resolved")
            else
                echo "!! No job with id '$tok', skipping."
            fi
        done
    else
        local -a DISPLAY=()
        local k
        for k in "${!JOB_HASH[@]}"; do
            DISPLAY+=("[${JOB_SID[$k]}] ${JOB_IN[$k]##*/}")
        done
        interactive_select DISPLAY 0
        if [ ${#SELECTED_FILES[@]} -eq 0 ]; then
            echo "Nothing selected, cancelled."
            return 0
        fi
        local sel sid
        for sel in "${SELECTED_FILES[@]}"; do
            sid="${sel#[}"; sid="${sid%%]*}"
            TO_DELETE+=("$(resolve_job_id "$sid")")
        done
    fi

    local count=0
    local id
    for id in "${TO_DELETE[@]}"; do
        if [ -n "$id" ] && [ -d "$JOBS_ROOT/$id" ]; then
            rm -rf "$JOBS_ROOT/$id"
            echo "Deleted job $id"
            count=$((count + 1))
        fi
    done
    echo "$count job(s) deleted."
    return 0
}

RESUME=false
RESUME_IDS=()
NEXT_SID=0
INPUTS=()
OUTPUTS=()
DIR_MODE=false
IN_DIR=""
SEARCH_PATTERN=""
EP_IN_PREFIX=""
EP_IN_LIST=""
EP_OUT_PREFIX=""
EP_OUT_LIST=""
CHUNK_OVERRIDE_MIN=""
DELETE_MODE=false
DELETE_IDS=()
DRY_RUN=false
RUN_LIMIT=""

# ---- arg parsing ----
ARGS=("$@")

if [ ${#ARGS[@]} -eq 0 ] || [ "${ARGS[0]}" == "--help" ] || [ "${ARGS[0]}" == "-h" ]; then
    print_help
    exit 0
fi

if [ "${ARGS[0]}" == "--jobs" ] || [ "${ARGS[0]}" == "-j" ]; then
    list_jobs
    exit 0
fi

i=0
while [ $i -lt ${#ARGS[@]} ]; do
    a="${ARGS[$i]}"
    case "$a" in
        --help|-h)
            print_help
            exit 0
            ;;
        --jobs|-j)
            list_jobs
            exit 0
            ;;
        --resume|-r)
            RESUME=true
            i=$((i+1))
            while [ $i -lt ${#ARGS[@]} ] && [[ "${ARGS[$i]}" =~ ^[0-9]+$ ]]; do
                RESUME_IDS+=("${ARGS[$i]}")
                i=$((i+1))
            done
            i=$((i-1))
            ;;
        --input|-i)
            i=$((i+1))
            while [ $i -lt ${#ARGS[@]} ] && [[ "${ARGS[$i]}" != -* ]]; do
                INPUTS+=("${ARGS[$i]}")
                i=$((i+1))
            done
            continue
            ;;
        --output|-o)
            i=$((i+1))
            while [ $i -lt ${#ARGS[@]} ] && [[ "${ARGS[$i]}" != -* ]]; do
                OUTPUTS+=("${ARGS[$i]}")
                i=$((i+1))
            done
            continue
            ;;
        --dir|-d)
            DIR_MODE=true
            i=$((i+1))
            IN_DIR="${ARGS[$i]}"
            ;;
        --search|-s)
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] || { echo "-s/--search needs a search word, e.g. -s attackS1"; exit 1; }
            SEARCH_PATTERN="${ARGS[$i]}"
            ;;
        --episodes|-e)
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] || { echo "-e/--episodes needs a prefix, e.g. -e attackS1E 1,2,4"; exit 1; }
            EP_PREFIX="${ARGS[$i]}"
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] || { echo "-e/--episodes needs episode numbers too, e.g. -e attackS1E 1,2,4"; exit 1; }
            [ -z "$EP_IN_PREFIX" ] || { echo "-e/--episodes can only be used once (for input names). Use -eo/--episodes-out for output names."; exit 1; }
            EP_IN_PREFIX="$EP_PREFIX"
            EP_IN_LIST="${ARGS[$i]}"
            ;;
        --episodes-out|-eo)
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] || { echo "-eo/--episodes-out needs a prefix, e.g. -eo cleanS1E 1,2,4"; exit 1; }
            [ -z "$EP_OUT_PREFIX" ] || { echo "-eo/--episodes-out can only be used once (for output names)."; exit 1; }
            EP_OUT_PREFIX="${ARGS[$i]}"
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] || { echo "-eo/--episodes-out needs episode numbers too, e.g. -eo cleanS1E 1,2,4"; exit 1; }
            EP_OUT_LIST="${ARGS[$i]}"
            ;;
        --dry-run|-n)
            DRY_RUN=true
            ;;
        --run-limit|-q)
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] && [[ "${ARGS[$i]}" =~ ^[0-9]+$ ]] || { echo "-q/--run-limit needs a number of jobs to run, e.g. -q 3"; exit 1; }
            RUN_LIMIT="${ARGS[$i]}"
            ;;
        --delete|-x)
            DELETE_MODE=true
            i=$((i+1))
            while [ $i -lt ${#ARGS[@]} ] && [[ "${ARGS[$i]}" != -* ]]; do
                DELETE_IDS+=("${ARGS[$i]}")
                i=$((i+1))
            done
            i=$((i-1))
            ;;
        --chunk|-c)
            i=$((i+1))
            [ $i -lt ${#ARGS[@]} ] && [[ "${ARGS[$i]}" =~ ^[0-9]+$ ]] || { echo "-c/--chunk needs a number of minutes, e.g. -c 12"; exit 1; }
            CHUNK_OVERRIDE_MIN="${ARGS[$i]}"
            ;;
        *)
            echo "Unknown argument: $a"
            exit 1
            ;;
    esac
    i=$((i+1))
done

fmt_time() {
    local s="$1"
    if [ "$s" -lt 60 ]; then
        echo "${s}s"
    elif [ "$s" -lt 3600 ]; then
        echo "$((s / 60))m $((s % 60))s"
    else
        echo "$((s / 3600))h $(((s % 3600) / 60))m"
    fi
}

is_video_ext() {
    local f="$1"
    local ext="${f##*.}"
    for e in $VIDEO_EXTS; do [ "$ext" == "$e" ] && return 0; done
    return 1
}

is_audio_ext() {
    local f="$1"
    local ext="${f##*.}"
    for e in $AUDIO_EXTS; do [ "$ext" == "$e" ] && return 0; done
    return 1
}

# add_default_ext <name> [reference_file]
# If <name> already has an extension, leave it. Otherwise default to .mp4,
# UNLESS a reference file (e.g. the paired input) is an audio file, in which
# case default to that reference's extension instead.
add_default_ext() {
    local f="$1" ref="$2"
    if [[ "$f" == *.* ]]; then echo "$f"; return 0; fi
    if [ -n "$ref" ] && is_audio_ext "$ref"; then
        echo "${f}.${ref##*.}"
    else
        echo "${f}.mp4"
    fi
}

# ============================================================
# interactive_select — checklist picker for -s.
# Arrow keys move, Space toggles a file, Enter/Tab confirms, q cancels.
# Fills global array SELECTED_FILES.
# Takes the source array BY NAME (bash-3 compatible — no namerefs).
# ============================================================
interactive_select() {
    local __src="$1"
    case "$__src" in
        ''|*[!A-Za-z0-9_]*) echo "!! interactive_select: bad array name '$__src'" >&2; return 1 ;;
    esac
    local -a ITEMS=()
    eval "ITEMS=(\"\${${__src}[@]}\")"
    local default_state="${2:-1}"   # 1 = everything selected by default, 0 = nothing selected
    local n=${#ITEMS[@]}
    local -a checked=()
    local i
    for ((i = 0; i < n; i++)); do checked[i]=$default_state; done
    local cur=0
    tput civis 2>/dev/null || true
    while true; do
        clear 2>/dev/null || true
        if [ "$default_state" -eq 1 ]; then
            echo "Found $n file(s). All selected by default."
        else
            echo "Found $n item(s). Nothing selected by default."
        fi
        echo "Up/Down = move, Space = toggle this one off/on, Enter = confirm, q = cancel"
        echo ""
        for ((i = 0; i < n; i++)); do
            local mark=" "
            [ "${checked[i]}" -eq 1 ] && mark="✔"
            if [ "$i" -eq "$cur" ]; then
                echo "> [$mark] ${ITEMS[i]}"
            else
                echo "  [$mark] ${ITEMS[i]}"
            fi
        done
        local key rest
        IFS= read -rsn1 key || key=""
        case "$key" in
            $'\x1b')
                read -rsn2 -t 0.05 rest || rest=""
                case "$rest" in
                    "[A") if [ "$cur" -gt 0 ]; then cur=$((cur - 1)); fi ;;
                    "[B") if [ "$cur" -lt $((n - 1)) ]; then cur=$((cur + 1)); fi ;;
                esac
                ;;
            " ")
                if [ "${checked[cur]}" -eq 1 ]; then checked[cur]=0; else checked[cur]=1; fi
                ;;
            $'\t' | "" | $'\n' | $'\r')
                break
                ;;
            q | Q)
                checked=()
                break
                ;;
        esac
    done
    tput cnorm 2>/dev/null || true
    clear 2>/dev/null || true
    SELECTED_FILES=()
    for ((i = 0; i < n; i++)); do
        [ "${checked[i]}" -eq 1 ] && SELECTED_FILES+=("${ITEMS[i]}")
    done
    return 0
}

if [ "$DELETE_MODE" = true ]; then
    delete_jobs "${DELETE_IDS[@]}"
    exit 0
fi

# ============================================================
# Hardware detection (once per run — not per file, hardware
# doesn't change mid-batch) + a heuristic for chunk sizing.
#
# NOTE: there's no single official table mapping "X GB RAM / Y GB
# VRAM -> best chunk size" for demucs; this is a practical heuristic
# based on how its memory use scales with clip length. Override
# anytime with -c/--chunk <minutes> if it's wrong for your box.
# ============================================================
HW_RAM_GB=$(free -g | awk '/^Mem:/{print $2}' || true)
[[ "$HW_RAM_GB" =~ ^[0-9]+$ ]] || { echo "!! Couldn't read total RAM from 'free -g', assuming 4GB (safe/slow settings)."; HW_RAM_GB=4; }
HW_GPU_VRAM_MB=0
if command -v nvidia-smi &>/dev/null; then
    HW_GPU_VRAM_MB="$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1)"
    [[ "$HW_GPU_VRAM_MB" =~ ^[0-9]+$ ]] || HW_GPU_VRAM_MB=0
fi
HW_VRAM_GB=$(( HW_GPU_VRAM_MB / 1024 ))

# SAFE_MAX_CHUNK_MIN — the biggest chunk size this box can take before
# a manual -c value risks an out-of-memory kill during demucs.
if [ "$HW_VRAM_GB" -ge 4 ]; then SAFE_MAX_CHUNK_MIN=60
elif [ "$HW_VRAM_GB" -ge 2 ]; then SAFE_MAX_CHUNK_MIN=20
elif [ "$HW_RAM_GB" -ge 16 ]; then SAFE_MAX_CHUNK_MIN=30
elif [ "$HW_RAM_GB" -ge 8 ]; then SAFE_MAX_CHUNK_MIN=15
elif [ "$HW_RAM_GB" -ge 6 ]; then SAFE_MAX_CHUNK_MIN=8
elif [ "$HW_RAM_GB" -ge 4 ]; then SAFE_MAX_CHUNK_MIN=5
else SAFE_MAX_CHUNK_MIN=3
fi

if [ -n "$CHUNK_OVERRIDE_MIN" ] && [ "$CHUNK_OVERRIDE_MIN" -gt "$SAFE_MAX_CHUNK_MIN" ]; then
    echo "!! Warning: -c $CHUNK_OVERRIDE_MIN (minutes) is bigger than what this machine"
    echo "   looks safe for (RAM ${HW_RAM_GB}GB, GPU VRAM ${HW_VRAM_GB}GB -> safe max ~${SAFE_MAX_CHUNK_MIN}min)."
    echo "   Bigger chunks = demucs may run out of memory mid-job and crash."
    read -rp "   Continue anyway with $CHUNK_OVERRIDE_MIN min chunks? [y/N] " CONFIRM
    case "$CONFIRM" in
        y|Y|yes|YES) ;;
        *) echo "Cancelled. Drop -c to let purevox pick a safe size automatically."; exit 1 ;;
    esac
fi

# smart_settings <duration_seconds> — sets SMART_MODEL / SMART_USE_CHUNKS / SMART_CHUNK_SEC.
# duration_seconds=0 means "unknown yet", treated as the safe/worst case.
smart_settings() {
    local dur_sec="$1"
    local dur_min=$(( dur_sec / 60 ))

    if [ "$HW_VRAM_GB" -ge 4 ]; then
        SMART_MODEL="htdemucs"; SMART_CHUNK_SEC=3600
        if [ "$dur_sec" -gt 0 ] && [ "$dur_min" -le 240 ]; then SMART_USE_CHUNKS=false; else SMART_USE_CHUNKS=true; fi
    elif [ "$HW_VRAM_GB" -ge 2 ]; then
        SMART_MODEL="htdemucs"; SMART_CHUNK_SEC=1200
        if [ "$dur_sec" -gt 0 ] && [ "$dur_min" -le 60 ]; then SMART_USE_CHUNKS=false; else SMART_USE_CHUNKS=true; fi
    elif [ "$HW_RAM_GB" -ge 16 ]; then
        SMART_MODEL="htdemucs"; SMART_CHUNK_SEC=1800
        if [ "$dur_sec" -gt 0 ] && [ "$dur_min" -le 180 ]; then SMART_USE_CHUNKS=false; else SMART_USE_CHUNKS=true; fi
    elif [ "$HW_RAM_GB" -ge 8 ]; then
        SMART_MODEL="htdemucs"; SMART_CHUNK_SEC=900
        if [ "$dur_sec" -gt 0 ] && [ "$dur_min" -le 45 ]; then SMART_USE_CHUNKS=false; else SMART_USE_CHUNKS=true; fi
    elif [ "$HW_RAM_GB" -ge 6 ]; then
        SMART_MODEL="hdemucs_mmi"; SMART_CHUNK_SEC=480; SMART_USE_CHUNKS=true
    elif [ "$HW_RAM_GB" -ge 4 ]; then
        SMART_MODEL="hdemucs_mmi"; SMART_CHUNK_SEC=300; SMART_USE_CHUNKS=true
    else
        SMART_MODEL="hdemucs_mmi"; SMART_CHUNK_SEC=180; SMART_USE_CHUNKS=true
    fi

    if [ -n "$CHUNK_OVERRIDE_MIN" ]; then
        SMART_USE_CHUNKS=true
        SMART_CHUNK_SEC=$(( CHUNK_OVERRIDE_MIN * 60 ))
    fi
}

# ============================================================
# -s <word> — search current folder only (must be run from
# inside it, no paths allowed), pick matches interactively.
# ============================================================
if [ -n "$SEARCH_PATTERN" ]; then
    CANDIDATES=()
    shopt -s nullglob nocaseglob
    for f in *"$SEARCH_PATTERN"*; do
        [ -f "$f" ] || continue
        { is_video_ext "$f" || is_audio_ext "$f"; } || continue
        CANDIDATES+=("$f")
    done
    shopt -u nullglob nocaseglob

    [ ${#CANDIDATES[@]} -gt 0 ] || { echo "No video/audio files matching '$SEARCH_PATTERN' here."; exit 1; }

    interactive_select CANDIDATES
    [ ${#SELECTED_FILES[@]} -gt 0 ] || { echo "Nothing selected, cancelled."; exit 1; }
    INPUTS+=("${SELECTED_FILES[@]}")
fi

# ============================================================
# -e <prefix> <numbers> — build INPUT filenames like attackS1E1,
# attackS1E2, attackS1E4 from "attackS1E" + "1,2,4" (ranges like
# "1-4" also work; files must already exist).
# -eo <prefix> <numbers> — same, but builds OUTPUT names instead
# (no existence check — these get created). Independent of -e,
# so it works whether or not -e/-i/--dir is also used.
# ============================================================
expand_episode_names() {
    local prefix="$1" list="$2" check_exists="$3"
    # bash-3 compatible: copy the caller's array (BY NAME) locally,
    # append to it here, then copy it back at the end.
    local __dest="$4"
    case "$__dest" in
        ''|*[!A-Za-z0-9_]*) echo "!! expand_episode_names: bad array name '$__dest'" >&2; return 1 ;;
    esac
    local -a OUT_ARR=()
    eval "OUT_ARR=(\"\${${__dest}[@]}\")"
    IFS=',' read -ra NUM_TOKENS <<< "$list"
    local -a nums=()
    for tok in "${NUM_TOKENS[@]}"; do
        if [[ "$tok" == *-* ]]; then
            local start="${tok%-*}" end="${tok#*-}"
            for ((n = start; n <= end; n++)); do nums+=("$n"); done
        else
            nums+=("$tok")
        fi
    done
    for n in "${nums[@]}"; do
        if [ "$check_exists" = true ]; then
            local found=""
            for ext in $VIDEO_EXTS $AUDIO_EXTS; do
                if [ -f "${prefix}${n}.${ext}" ]; then found="${prefix}${n}.${ext}"; break; fi
            done
            if [ -z "$found" ]; then
                echo "!! ${prefix}${n}: no matching file here, skipping."
                continue
            fi
            OUT_ARR+=("$found")
        else
            OUT_ARR+=("$(add_default_ext "${prefix}${n}")")
        fi
    done
    eval "${__dest}=(\"\${OUT_ARR[@]}\")"
}

if [ -n "$EP_IN_PREFIX" ]; then
    expand_episode_names "$EP_IN_PREFIX" "$EP_IN_LIST" true INPUTS
fi
if [ -n "$EP_OUT_PREFIX" ]; then
    expand_episode_names "$EP_OUT_PREFIX" "$EP_OUT_LIST" false OUTPUTS
fi
if [ ${#INPUTS[@]} -gt 0 ] && [ ${#OUTPUTS[@]} -gt 1 ] && [ ${#INPUTS[@]} -ne ${#OUTPUTS[@]} ]; then
    echo "Input count (${#INPUTS[@]}) does not match output count (${#OUTPUTS[@]}). Fix that before running."
    exit 1
fi

# ============================================================
# Build final INPUTS[] / OUTPUTS[] pairing, whatever mode used
# ============================================================
PAIR_IN=()
PAIR_OUT=()

if $DIR_MODE; then
    [ -d "$IN_DIR" ] || { echo "Input folder not found: $IN_DIR"; exit 1; }
    [ ${#OUTPUTS[@]} -eq 1 ] || { echo "--dir mode needs exactly one -o (output folder)."; exit 1; }
    OUT_TARGET="${OUTPUTS[0]}"
    is_video_ext "$OUT_TARGET" && { echo "--dir mode needs an output FOLDER, not a filename."; exit 1; }
    mkdir -p "$OUT_TARGET"

    for f in "$IN_DIR"/*; do
        [ -f "$f" ] || continue
        { is_video_ext "$f" || is_audio_ext "$f"; } || continue
        base="$(basename "$f")"
        name="${base%.*}"
        ext="${f##*.}"
        PAIR_IN+=("$f")
        PAIR_OUT+=("$OUT_TARGET/${name}.${ext}")
    done

elif [ ${#INPUTS[@]} -gt 0 ] || [ ${#OUTPUTS[@]} -gt 0 ]; then
    [ ${#INPUTS[@]} -gt 0 ]  || { echo "No -i input(s) given."; exit 1; }
    [ ${#OUTPUTS[@]} -gt 0 ] || { echo "No -o output(s) given."; exit 1; }

    if [ ${#OUTPUTS[@]} -eq 1 ] && ! is_video_ext "${OUTPUTS[0]}" && [ ${#INPUTS[@]} -gt 1 ]; then
        # single output = folder, multiple inputs -> auto-name inside it
        OUT_TARGET="${OUTPUTS[0]}"
        mkdir -p "$OUT_TARGET"
        for f in "${INPUTS[@]}"; do
            f="$(add_default_ext "$f")"
            base="$(basename "$f")"
            name="${base%.*}"
            ext="${f##*.}"
            PAIR_IN+=("$f")
            PAIR_OUT+=("$OUT_TARGET/${name}.${ext}")
        done
    else
        # explicit pairwise
        if [ ${#INPUTS[@]} -ne ${#OUTPUTS[@]} ]; then
            echo "Input count (${#INPUTS[@]}) does not match output count (${#OUTPUTS[@]})."
            exit 1
        fi
        for idx in "${!INPUTS[@]}"; do
            PAIR_IN+=("$(add_default_ext "${INPUTS[$idx]}")")
            PAIR_OUT+=("$(add_default_ext "${OUTPUTS[$idx]}" "${INPUTS[$idx]}")")
        done
    fi

elif $RESUME; then
    : # bare "-r", handled below — scan all pending jobs instead
else
    echo "Usage:"
    echo "  purevox -i/--input in.mp4 -o/--output out.mp4"
    echo "  purevox -i in1 in2 -o out1 out2"
    echo "  purevox -i in1 in2 -o output_folder/"
    echo "  purevox -d/--dir input_folder/ -o output_folder/"
    echo "  purevox -r/--resume            (resume pending jobs — asks if more than one)"
    exit 1
fi

# ============================================================
# Bare "-r" (optionally with ids) — no -i/-o/--dir given.
# ============================================================
if $RESUME && [ ${#PAIR_IN[@]} -eq 0 ] && [ ${#PAIR_OUT[@]} -eq 0 ]; then
    get_pending_jobs
    if [ ${#JOB_HASH[@]} -eq 0 ]; then
        echo "No pending jobs found."
        exit 0
    fi

    if [ ${#RESUME_IDS[@]} -gt 0 ]; then
        # explicit ids given: -r 0  or  -r 0 2 5
        for tok in "${RESUME_IDS[@]}"; do
            resolved="$(resolve_job_id "$tok")"
            if [ -z "$resolved" ]; then
                echo "!! No job with id '$tok'. Run 'purevox --jobs' to see valid ids."
                exit 1
            fi
            for k in "${!JOB_HASH[@]}"; do
                if [ "${JOB_HASH[$k]}" == "$resolved" ]; then
                    PAIR_IN+=("${JOB_IN[$k]}")
                    PAIR_OUT+=("${JOB_OUT[$k]}")
                fi
            done
        done
        echo "Resuming ${#PAIR_IN[@]} job(s): ${RESUME_IDS[*]}"

    elif [ ${#JOB_HASH[@]} -eq 1 ]; then
        # only one pending job — just resume it, no need to ask
        PAIR_IN+=("${JOB_IN[0]}")
        PAIR_OUT+=("${JOB_OUT[0]}")
        echo "Resuming the one pending job: [${JOB_SID[0]}] ${JOB_IN[0]##*/}"

    else
        # several pending jobs, none specified — pick from a checklist
        DISPLAY=()
        for k in "${!JOB_HASH[@]}"; do
            DISPLAY+=("[${JOB_SID[$k]}] ${JOB_IN[$k]##*/}")
        done
        interactive_select DISPLAY 1
        if [ ${#SELECTED_FILES[@]} -eq 0 ]; then
            echo "Nothing selected, cancelled."
            exit 0
        fi
        for sel in "${SELECTED_FILES[@]}"; do
            sid="${sel#[}"; sid="${sid%%]*}"
            resolved="$(resolve_job_id "$sid")"
            for k in "${!JOB_HASH[@]}"; do
                if [ "${JOB_HASH[$k]}" == "$resolved" ]; then
                    PAIR_IN+=("${JOB_IN[$k]}")
                    PAIR_OUT+=("${JOB_OUT[$k]}")
                fi
            done
        done
        echo "Resuming ${#PAIR_IN[@]} job(s)."
    fi
fi

# ============================================================
# --dry-run — just show the plan, touch nothing
# ============================================================
if $DRY_RUN; then
    echo "=== Dry run: ${#PAIR_IN[@]} job(s), nothing will actually run ==="
    for idx in "${!PAIR_IN[@]}"; do
        note=""
        [ -e "${PAIR_OUT[$idx]}" ] && note="  [output already exists]"
        echo "  $((idx+1)). ${PAIR_IN[$idx]} -> ${PAIR_OUT[$idx]}${note}"
    done
    if [ -n "$RUN_LIMIT" ]; then
        echo "-q $RUN_LIMIT set: only the first $RUN_LIMIT of these would actually run this time."
    fi
    exit 0
fi

# ============================================================
# Output-already-exists check, before touching anything
# ============================================================
CONFLICTS=()
for idx in "${!PAIR_OUT[@]}"; do
    [ -e "${PAIR_OUT[$idx]}" ] && CONFLICTS+=("$idx")
done

if [ ${#CONFLICTS[@]} -gt 0 ]; then
    if [ ${#PAIR_IN[@]} -eq 1 ]; then
        echo "Output already exists: ${PAIR_OUT[0]}"
        read -rp "Overwrite it? [y/N] " ans
        case "$ans" in
            y|Y|yes|YES) ;;
            *) echo "Cancelled."; exit 0 ;;
        esac
    else
        echo "${#CONFLICTS[@]} of ${#PAIR_IN[@]} output(s) already exist:"
        for idx in "${CONFLICTS[@]}"; do
            echo "  - ${PAIR_OUT[$idx]}"
        done
        echo "(o)verwrite all, (s)kip these and continue with the rest, (c)ancel everything?"
        read -rp "[o/s/c] " ans
        case "$ans" in
            o|O)
                : # leave as is, ffmpeg -y overwrites anyway
                ;;
            s|S)
                NEW_IN=(); NEW_OUT=()
                for idx in "${!PAIR_IN[@]}"; do
                    skip=false
                    for cidx in "${CONFLICTS[@]}"; do
                        [ "$idx" -eq "$cidx" ] && skip=true
                    done
                    if [ "$skip" = false ]; then
                        NEW_IN+=("${PAIR_IN[$idx]}")
                        NEW_OUT+=("${PAIR_OUT[$idx]}")
                    fi
                done
                PAIR_IN=("${NEW_IN[@]}")
                PAIR_OUT=("${NEW_OUT[@]}")
                echo "Skipping ${#CONFLICTS[@]}, continuing with ${#PAIR_IN[@]} job(s)."
                ;;
            *)
                echo "Cancelled."
                exit 0
                ;;
        esac
    fi
fi

# ============================================================
# -q <N> — register everything, but only actually RUN N of them
# ============================================================
if [ -n "$RUN_LIMIT" ]; then
    if [ "$RUN_LIMIT" -ge "${#PAIR_IN[@]}" ]; then
        echo "-q $RUN_LIMIT: only ${#PAIR_IN[@]} job(s) available, running all of them."
        RUN_LIMIT=""
    else
        echo "-q $RUN_LIMIT: registering all ${#PAIR_IN[@]} job(s), running the first $RUN_LIMIT now."
    fi
fi

# ============================================================
# register_job — pre-create job dir + state.json for a file
# BEFORE any processing starts, so --jobs / -r see the whole
# batch immediately, not just whichever file is currently running.
# ============================================================
register_job() {
    local INPUT="$1"
    local OUTPUT="$2"

    if [ ! -f "$INPUT" ]; then
        echo "!! Input not found, skipping: $INPUT"
        return 0
    fi

    local ABS_INPUT
    ABS_INPUT="$(readlink -f "$INPUT")"
    local JOB_ID
    JOB_ID="$(job_hash "$ABS_INPUT")"
    local JOB_DIR="$HOME/.purevox/jobs/$JOB_ID"
    local STATE_FILE="$JOB_DIR/state.json"
    mkdir -p "$JOB_DIR/stems"

    [ -f "$STATE_FILE" ] && return   # already registered (earlier interrupted run) — keep progress

    local DUR_SEC
    DUR_SEC="$(ffprobe -i "$ABS_INPUT" -show_entries format=duration -v quiet -of csv="p=0" 2>/dev/null | cut -d. -f1)"
    [[ "$DUR_SEC" =~ ^[0-9]+$ ]] || DUR_SEC=0

    smart_settings "$DUR_SEC"

    local TOTAL_CHUNKS=0
    if $SMART_USE_CHUNKS; then
        TOTAL_CHUNKS=$(( (DUR_SEC + SMART_CHUNK_SEC - 1) / SMART_CHUNK_SEC ))
        [ "$TOTAL_CHUNKS" -eq 0 ] && TOTAL_CHUNKS=1
    fi

    write_job_state "$STATE_FILE" "$NEXT_SID" "$ABS_INPUT" "$OUTPUT" \
        "$SMART_MODEL" "$SMART_USE_CHUNKS" "$TOTAL_CHUNKS" "$SMART_CHUNK_SEC" ""
    NEXT_SID=$((NEXT_SID + 1))
}

# ============================================================
# process_one — everything the old single-file script did,
# now wrapped as a function so batch mode can loop it.
# ============================================================
process_one() {
    local INPUT="$1"
    local OUTPUT="$2"
    local DO_RESUME="$3"

    if [ ! -f "$INPUT" ]; then
        echo "!! Input not found, skipping: $INPUT"
        return
    fi

    local ABS_INPUT
    ABS_INPUT="$(readlink -f "$INPUT")"

    local JOB_ID
    JOB_ID="$(job_hash "$ABS_INPUT")"
    local JOB_DIR="$HOME/.purevox/jobs/$JOB_ID"
    local STATE_FILE="$JOB_DIR/state.json"
    local STEMS_DIR="$JOB_DIR/stems"
    mkdir -p "$STEMS_DIR"

    if [ ! -f "$STATE_FILE" ]; then
        # safety net: shouldn't happen since register_job runs first, but
        # cover direct/old callers by registering on the fly.
        register_job "$INPUT" "$OUTPUT"
    fi
    echo "=== [$INPUT] Job $JOB_ID ==="

    local WORKDIR
    WORKDIR="$(mktemp -d)"
    local AUDIO_FULL="$WORKDIR/audio_full.mp3"
    cleanup() { rm -rf "$WORKDIR"; }
    trap cleanup RETURN

    echo "=== Step 1: Hardware ==="
    echo "    RAM ${HW_RAM_GB}GB, GPU VRAM ${HW_VRAM_GB}GB"

    local IS_AUDIO_JOB=false
    is_audio_ext "$OUTPUT" && IS_AUDIO_JOB=true
    [ "$IS_AUDIO_JOB" = true ] && echo "    Audio-only job (output is .${OUTPUT##*.}) — no video remux at the end."

    local MODEL USE_CHUNKS SHORT_ID TOTAL_CHUNKS CHUNK_DURATION COMPLETED_LIST
    local rs=""
    rs="$(read_state "$STATE_FILE")" || rs=""
    if [ -n "$rs" ]; then eval "$rs"; fi
    if [ -z "$MODEL" ] || [ -z "$USE_CHUNKS" ]; then
        echo "!! Couldn't read job state from $STATE_FILE (corrupt or unexpected format)."
        echo "!! Delete that job dir and re-run: rm -rf \"$JOB_DIR\""
        return 1
    fi
    echo "    Using model=$MODEL, chunked=$USE_CHUNKS"

    local COMPLETED=()
    if [ -n "$COMPLETED_LIST" ]; then
        IFS=',' read -ra COMPLETED <<< "$COMPLETED_LIST"
    fi

    write_state() {
        write_job_state "$STATE_FILE" "${SHORT_ID:-0}" "$ABS_INPUT" "$OUTPUT" \
            "$MODEL" "$USE_CHUNKS" "${TOTAL_CHUNKS:-0}" "${CHUNK_DURATION:-0}" \
            "$(IFS=,; echo "${COMPLETED[*]:-}")"
    }

    is_done() {
        local n="$1"
        for c in "${COMPLETED[@]:-}"; do [ "$c" == "$n" ] && return 0; done
        return 1
    }

    [ -f "$STATE_FILE" ] || write_state

    if [ -f "$STEMS_DIR/audio_full.mp3" ]; then
        echo "=== Step 2: Audio already extracted, reusing ==="
        cp "$STEMS_DIR/audio_full.mp3" "$AUDIO_FULL"
    else
        echo "=== Step 2: Extracting audio ==="
        ffmpeg -y -i "$ABS_INPUT" -vn -ar 44100 -ac 2 -b:a 192k "$AUDIO_FULL" -loglevel error
        cp "$AUDIO_FULL" "$STEMS_DIR/audio_full.mp3"
    fi

    local FINAL_VOCALS="$WORKDIR/final_vocals.mp3"

    if [ "$USE_CHUNKS" = false ]; then
        local STEM_CACHE="$STEMS_DIR/vocals.mp3"
        if [ -f "$STEM_CACHE" ]; then
            echo "=== Step 3: Vocals already separated, reusing ==="
            cp "$STEM_CACHE" "$FINAL_VOCALS"
        else
            echo "=== Step 3: Separating vocals (full file) ==="
            local STEP3_START
            STEP3_START=$(date +%s)
            demucs --mp3 --mp3-bitrate 192 --two-stems vocals -n "$MODEL" \
                -o "$WORKDIR/separated" "$AUDIO_FULL" 2>&1 | grep -v "^$" || true
            echo "    Took $(fmt_time $(( $(date +%s) - STEP3_START )))."
            local BASENAME
            BASENAME=$(basename "$AUDIO_FULL" .mp3)
            cp "$WORKDIR/separated/${MODEL}/${BASENAME}/vocals.mp3" "$FINAL_VOCALS"
            cp "$FINAL_VOCALS" "$STEM_CACHE"
        fi
    else
        echo "=== Step 3: Smart chunking for low-spec mode ==="
        local DURATION
        DURATION=$(ffprobe -i "$AUDIO_FULL" -show_entries format=duration -v quiet -of csv="p=0" | cut -d. -f1)
        echo "    Total duration: ${DURATION}s"

        # TOTAL_CHUNKS / CHUNK_DURATION were parsed with the rest of the
        # state above; only completed_chunks mutates during processing.
        [[ "$TOTAL_CHUNKS" =~ ^[0-9]+$ ]] || { echo "!! Couldn't read total_chunks from state file, aborting this job."; return 1; }
        [[ "$CHUNK_DURATION" =~ ^[0-9]+$ ]] || { echo "!! Couldn't read chunk_duration from state file, aborting this job."; return 1; }
        echo "    Chunks: $TOTAL_CHUNKS × ~${CHUNK_DURATION}s each"

        local CHUNK_DIR="$WORKDIR/chunks"
        local SEPARATED_DIR="$WORKDIR/separated"
        mkdir -p "$CHUNK_DIR" "$SEPARATED_DIR"

        ffmpeg -y -i "$AUDIO_FULL" -f segment -segment_time "$CHUNK_DURATION" -c copy \
            "$CHUNK_DIR/chunk_%03d.mp3" -loglevel error

        local CONCAT_LIST="$WORKDIR/concat.txt"
        > "$CONCAT_LIST"

        local idx=0
        local AVG_CHUNK_TIME=0
        local CHUNKS_TIMED=0
        for CHUNK in $(ls "$CHUNK_DIR"/chunk_*.mp3 | sort); do
            local CHUNK_NAME STEM_CACHE
            CHUNK_NAME=$(basename "$CHUNK" .mp3)
            STEM_CACHE="$STEMS_DIR/${CHUNK_NAME}_vocals.mp3"

            if is_done "$idx" && [ -f "$STEM_CACHE" ]; then
                echo "    $CHUNK_NAME already done, skipping."
            else
                echo "    Processing $CHUNK_NAME ..."
                local CHUNK_START CHUNK_ELAPSED REMAINING
                CHUNK_START=$(date +%s)
                demucs --mp3 --mp3-bitrate 192 --two-stems vocals -n "$MODEL" \
                    -o "$SEPARATED_DIR" "$CHUNK" 2>&1 | grep -v "^$" || true
                cp "$SEPARATED_DIR/${MODEL}/${CHUNK_NAME}/vocals.mp3" "$STEM_CACHE"
                COMPLETED+=("$idx")
                write_state
                CHUNK_ELAPSED=$(( $(date +%s) - CHUNK_START ))
                CHUNKS_TIMED=$((CHUNKS_TIMED + 1))
                AVG_CHUNK_TIME=$(( (AVG_CHUNK_TIME * (CHUNKS_TIMED - 1) + CHUNK_ELAPSED) / CHUNKS_TIMED ))
                REMAINING=$(( TOTAL_CHUNKS - idx - 1 ))
                echo "    Took $(fmt_time "$CHUNK_ELAPSED"). ETA for this file: ~$(fmt_time $((AVG_CHUNK_TIME * REMAINING)))"
            fi
            echo "file '$STEM_CACHE'" >> "$CONCAT_LIST"
            idx=$((idx+1))
        done

        echo "=== Step 3b: Merging vocal chunks ==="
        ffmpeg -y -f concat -safe 0 -i "$CONCAT_LIST" -c copy "$FINAL_VOCALS" -loglevel error
    fi

    if [ "$IS_AUDIO_JOB" = true ]; then
        echo "=== Step 4: Saving vocals-only audio ==="
        mkdir -p "$(dirname "$OUTPUT")" 2>/dev/null || true
        ffmpeg -y -i "$FINAL_VOCALS" "$OUTPUT" -loglevel error
    else
        echo "=== Step 4: Remuxing audio onto video ==="
        mkdir -p "$(dirname "$OUTPUT")" 2>/dev/null || true
        ffmpeg -y -i "$ABS_INPUT" -i "$FINAL_VOCALS" -map 0:v -map 1:a -c:v copy -shortest \
            "$OUTPUT" -loglevel error
    fi

    rm -rf "$JOB_DIR"
    echo "=== Done: $OUTPUT ==="
    echo ""
}

# ============================================================
# Register ALL jobs first (so --jobs / a mid-batch Ctrl+C shows
# every file, not just whichever one happens to be running),
# THEN process them one by one.
# ============================================================
init_next_sid
for idx in "${!PAIR_IN[@]}"; do
    register_job "${PAIR_IN[$idx]}" "${PAIR_OUT[$idx]}"
done

TOTAL_JOBS=${#PAIR_IN[@]}
RUN_COUNT=0
for idx in "${!PAIR_IN[@]}"; do
    if [ -n "$RUN_LIMIT" ] && [ "$RUN_COUNT" -ge "$RUN_LIMIT" ]; then
        echo "-q limit reached ($RUN_LIMIT run). $((TOTAL_JOBS - RUN_LIMIT)) job(s) left registered — resume anytime with 'purevox -r'."
        break
    fi
    RUN_COUNT=$((RUN_COUNT + 1))
    echo "############ Job $RUN_COUNT of $TOTAL_JOBS ############"
    process_one "${PAIR_IN[$idx]}" "${PAIR_OUT[$idx]}" "$RESUME"
done
